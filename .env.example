# --- Todo es opcional: sin nada de esto la app funciona subiendo PDF a mano ---

# Traer extractos desde Gmail (OAuth, solo lectura). Ver README.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Lector universal con IA para bancos sin lector propio (o cuando el propio no cuadra)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Buzón de reenvío (extractos+codigo@tu-dominio)
NEXT_PUBLIC_INBOX_ADDRESS=extractos@buzon.tudominio.co
INBOUND_SECRET=una-clave-larga-y-aleatoria
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Solo para probar en tu computador, sin Upstash:
# INBOX_DEV_MEMORY=1
